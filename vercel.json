{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "crons": [
    {
      "path": "/api/cron-notifications?type=morning",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron-notifications?type=morning",
      "schedule": "40 4 * * *"
    },
    {
      "path": "/api/cron-notifications?type=pulse",
      "schedule": "*/5 * * * *"
    }
  ]
}
